{
  "name": "web-control-plus",
  "version": "2.1.0",
  "type": "module",
  "description": "Web interface to control Lego hubs",
  "scripts": {
    "predev": "patch-package",
    "dev": "vite",
    "preview": "vite preview --host 0.0.0.0 --port 8000 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx src tests vite.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "pretest": "patch-package",
    "test": "node --test tests/*.test.ts",
    "prebuild:src": "patch-package",
    "build:src": "vite build",
    "build": "npm run typecheck && npm run build:src"
  },
  "author": "aileo",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "node-poweredup": "10.1.0",
    "process": "^0.11.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/tinycolor2": "^1.4.6",
    "@types/web-bluetooth": "^0.0.21",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^31.0.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "browserslist": [
    "last 3 Chrome versions"
  ]
}
