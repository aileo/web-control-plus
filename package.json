{
  "name": "web-control-plus",
  "version": "0.1.1",
  "description": "Web interface to control Lego hubs",
  "scripts": {
    "dev": "parcel serve index.html --host 0.0.0.0 --port 8000 --no-autoinstall",
    "lint:js": "eslint --ext .jsx,.js src",
    "lint:scss": "stylelint \"style/**/*.scss\"",
    "lint": "npm run lint:scss && npm run lint:js",
    "build:clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:src": "parcel build index.html --dist-dir dist --public-url ./ --no-autoinstall",
    "build": "npm run build:clean && npm run build:src",
    "publish": "npm run build && gh-pages -d dist"
  },
  "author": "aileo",
  "license": "MIT",
  "dependencies": {
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "async": "^3.2.6",
    "baobab": "^2.6.1",
    "baobab-react": "^4.0.2",
    "bootstrap-scss": "^4.6.2",
    "buffer": "^6.0.3",
    "classnames": "^2.5.1",
    "events": "^3.3.0",
    "lodash": "^4.18.1",
    "node-poweredup": "^5.0.2",
    "process": "^0.11.10",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "gh-pages": "^6.3.0",
    "http-proxy-middleware": "^3.0.5",
    "parcel": "^2.16.4",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.7.4",
    "sass": "^1.108.2",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^16.0.0",
    "stylelint-scss": "^6.12.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "browserslist": [
    "last 3 Chrome versions"
  ]
}
